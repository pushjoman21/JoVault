+//! Private source-retention regression tests; default behavior remains upstream.
+use crate::{Context, Module, Script, Source};
+
+fn number(source: &str, retain: bool) -> f64 {
+    let mut context = Context::builder()
+        .retain_source_text(retain)
+        .build()
+        .unwrap();
+    context
+        .eval(Source::from_bytes(source))
+        .unwrap()
+        .as_number()
+        .unwrap()
+}
+
+#[test]
+fn nested_class_closure_and_source_fallback() {
+    let source = r#"
+        /* SOURCE_COMMENT_ONLY_STATIC */
+        function outer(n) {
+            class Counter { #n = n; value() { return () => this.#n; } }
+            return new Counter().value();
+        }
+        const f = outer(42);
+        f() + (outer.toString().includes('[native code]') ? 1 : 0)
+    "#;
+    assert_eq!(number(source, true), 42.0);
+    assert_eq!(number(source, false), 43.0);
+}
+
+#[test]
+fn absent_source_is_preserved_in_script_and_nested_code() {
+    let mut context = Context::builder()
+        .retain_source_text(false)
+        .build()
+        .unwrap();
+    let script = Script::parse(
+        Source::from_bytes("function f() { return () => 42; } f()();"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    let code = script.codeblock(&mut context).unwrap();
+    assert!(code.source_info().text_spanned().to_code_points().is_none());
+    assert_eq!(
+        script.evaluate(&mut context).unwrap().as_number(),
+        Some(42.0)
+    );
+}
+
+#[test]
+fn module_link_and_evaluate_remain_separate() {
+    let mut context = Context::builder()
+        .retain_source_text(false)
+        .build()
+        .unwrap();
+    let module = Module::parse(
+        Source::from_bytes("export function main() { return 42; }"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    let loaded = module.load(&mut context);
+    context.run_jobs().unwrap();
+    assert!(matches!(
+        loaded.state(),
+        crate::builtins::promise::PromiseState::Fulfilled(_)
+    ));
+    module.link(&mut context).unwrap();
+    let evaluated = module.evaluate(&mut context).unwrap();
+    context.run_jobs().unwrap();
+    assert!(matches!(
+        evaluated.state(),
+        crate::builtins::promise::PromiseState::Fulfilled(_)
+    ));
+}
+
+#[test]
+fn json_reviver_source_is_data_and_must_survive() {
+    assert_eq!(
+        number(
+            r#"JSON.parse('123', (k, v, c) => k === '' ? Number(c.source) : v)"#,
+            false
+        ),
+        123.0
+    );
+}
+
+#[test]
+fn dynamic_compilation_semantics_survive_discard() {
+    assert_eq!(number("eval('let x = 40; x + 2')", false), 42.0);
+    assert_eq!(number("Function('n', 'return n + 2')(40)", false), 42.0);
+}
