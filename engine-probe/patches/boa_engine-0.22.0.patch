+#[test]
+fn source_visibility_hook_is_respected_when_retained() {
+    struct Hidden;
+    impl crate::context::HostHooks for Hidden {
+        fn has_source_text_available(
+            &self,
+            _function: &crate::object::JsFunction,
+            _context: &mut Context,
+        ) -> bool {
+            false
+        }
+    }
+    let mut context = Context::builder()
+        .host_hooks(std::rc::Rc::new(Hidden))
+        .build()
+        .unwrap();
+    let result = context
+        .eval(Source::from_bytes(
+            "function f() { return 42; } f.toString().includes('[native code]')",
+        ))
+        .unwrap();
+    assert_eq!(result.as_boolean(), Some(true));
+}
