+//! Default-export anonymous class NamedEvaluation regressions.
+use crate::builtins::promise::PromiseState;
+use crate::context::time::FixedClock;
+use crate::module::MapModuleLoader;
+use crate::{Context, JsValue, Module, Source, js_string};
+use std::{path::Path, rc::Rc};
+
+fn check(source: &str) {
+    let loader = Rc::new(MapModuleLoader::new());
+    let builder = Context::builder()
+        .retain_source_text(false)
+        .clock(Rc::new(FixedClock::default()))
+        .module_loader(loader.clone());
+    #[cfg(feature = "instruction-budget")]
+    let builder = builder.instructions_remaining(200_000);
+    let mut context = builder.build().unwrap();
+    let module = Module::parse(
+        Source::from_bytes(source).with_path(Path::new("/case.mjs")),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    loader.insert("/case.mjs", module.clone());
+    let loaded = module.load(&mut context);
+    context.run_jobs().unwrap();
+    assert!(matches!(loaded.state(), PromiseState::Fulfilled(_)));
+    module.link(&mut context).unwrap();
+    let evaluated = module.evaluate(&mut context).unwrap();
+    context.run_jobs().unwrap();
+    assert!(
+        matches!(evaluated.state(), PromiseState::Fulfilled(_)),
+        "{:?}",
+        evaluated.state()
+    );
+    let main = module
+        .get_value(js_string!("main"), &mut context)
+        .unwrap()
+        .as_callable()
+        .unwrap();
+    assert_eq!(
+        main.call(&JsValue::undefined(), &[], &mut context)
+            .unwrap()
+            .as_boolean(),
+        Some(true)
+    );
+}
