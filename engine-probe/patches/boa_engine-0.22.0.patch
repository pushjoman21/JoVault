+//! Dedicated fuel regression tests. This feature does not enable fuzzing.
+use crate::builtins::promise::PromiseState;
+use crate::context::time::FixedClock;
+use crate::error::EngineError;
+use crate::module::IdleModuleLoader;
+use crate::{Context, JsError, JsResult, JsValue, Module, Script, Source, js_string};
+use std::rc::Rc;
+
+fn context(fuel: usize) -> Context {
+    Context::builder()
+        .retain_source_text(false)
+        .instructions_remaining(fuel)
+        .clock(Rc::new(FixedClock::default()))
+        .module_loader(Rc::new(IdleModuleLoader))
+        .build()
+        .unwrap()
+}
+
+fn exhausted(error: JsError) {
+    assert!(matches!(
+        error.as_engine(),
+        Some(EngineError::NoInstructionsRemain)
+    ));
+    assert!(!error.is_catchable());
+}
+
+fn global_number(context: &mut Context, name: &str) -> Option<f64> {
+    let global = context.global_object();
+    global
+        .get(crate::JsString::from(name), context)
+        .unwrap()
+        .as_number()
+}
+
+fn linked(source: &str, context: &mut Context) -> Module {
+    let before = context.instructions_remaining();
+    let module = Module::parse(Source::from_bytes(source), None, context).unwrap();
+    let loaded = module.load(context);
+    context.run_jobs().unwrap();
+    assert!(matches!(loaded.state(), PromiseState::Fulfilled(_)));
+    module.link(context).unwrap();
+    assert_eq!(context.instructions_remaining(), before);
+    module
+}
+
+fn evaluate(module: &Module, context: &mut Context) -> JsResult<()> {
+    let promise = module.evaluate(context)?;
+    context.run_jobs()?;
+    match promise.state() {
+        PromiseState::Fulfilled(_) => Ok(()),
+        PromiseState::Rejected(error) => Err(JsError::from_opaque(error)),
+        PromiseState::Pending => panic!("fixture must settle"),
+    }
+}
+
+#[test]
+#[cfg(not(feature = "fuzz"))]
+fn default_remains_compatible_and_explicit_zero_is_zero() {
+    let mut default = Context::default();
+    assert_eq!(default.instructions_remaining(), usize::MAX);
+    assert_eq!(
+        default.eval(Source::from_bytes("42")).unwrap().as_number(),
+        Some(42.0)
+    );
+    let mut zero = context(0);
+    let script = Script::parse(
+        Source::from_bytes("globalThis.mustNotRun = 1"),
+        None,
+        &mut zero,
+    )
+    .unwrap();
+    script.codeblock(&mut zero).unwrap();
+    assert_eq!(zero.instructions_remaining(), 0);
+    exhausted(script.evaluate(&mut zero).unwrap_err());
+    assert_eq!(global_number(&mut zero, "mustNotRun"), None);
+}
+
+#[test]
+fn parse_compile_load_link_do_not_spend_guest_fuel() {
+    let mut zero = context(0);
+    let script = Script::parse(
+        Source::from_bytes("function f() { return () => 42; }"),
+        None,
+        &mut zero,
+    )
+    .unwrap();
+    script.codeblock(&mut zero).unwrap();
+    let _module = linked("export function main() { return 42; }", &mut zero);
+    assert_eq!(zero.instructions_remaining(), 0);
+}
+
+#[test]
+fn nested_catch_finally_cannot_escape_exhaustion() {
+    let mut ctx = context(300);
+    let before_frames = ctx.vm.frames.len();
+    let error = ctx
+        .eval(Source::from_bytes(
+            r#"
+        globalThis.started = 1;
+        function inner() {
+            while (true) {
+                try { while (true) {} }
+                catch (_) { globalThis.caught = 1; }
+                finally { globalThis.finalized = 1; }
+            }
+        }
+        function outer() { inner(); globalThis.returned = 1; }
+        outer();
+        globalThis.after = 1;
+    "#,
+        ))
+        .unwrap_err();
+    exhausted(error);
+    assert_eq!(ctx.instructions_remaining(), 0);
+    assert_eq!(ctx.vm.frames.len(), before_frames);
+    assert_eq!(global_number(&mut ctx, "started"), Some(1.0));
+    for name in ["caught", "finalized", "returned", "after"] {
+        assert_eq!(global_number(&mut ctx, name), None);
+    }
+    exhausted(
+        ctx.eval(Source::from_bytes("globalThis.after = 2"))
+            .unwrap_err(),
+    );
+    assert_eq!(global_number(&mut ctx, "after"), None);
+}
+
+#[test]
+fn ample_budget_returns_expected_value_and_decreases() {
+    let mut ctx = context(200_000);
+    let result = ctx
+        .eval(Source::from_bytes(
+            "let s = 0; for (let i = 0; i < 100; i++) s += i; s",
+        ))
+        .unwrap();
+    assert_eq!(result.as_number(), Some(4950.0));
+    assert!(ctx.instructions_remaining() < 200_000);
+    assert!(ctx.instructions_remaining() > 0);
+}
+
+#[test]
+fn module_initialization_and_export_call_share_budget() {
+    let mut ctx = context(600);
+    let module = linked(
+        r#"
