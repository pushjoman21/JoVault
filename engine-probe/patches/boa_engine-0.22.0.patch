+#[test]
+fn module_call_and_promise_jobs_share_budget() {
+    let mut ctx = context(600);
+    let module = linked(
+        r#"
+        globalThis.initialized = 1;
+        export function main() {
+            globalThis.called = 1;
+            Promise.resolve().then(() => {
+                globalThis.jobStarted = 1;
+                try { while (true) {} }
+                catch (_) { globalThis.jobCaught = 1; }
+                globalThis.jobAfter = 1;
+            });
+            return 42;
+        }
+    "#,
+        &mut ctx,
+    );
+    evaluate(&module, &mut ctx).unwrap();
+    let after_init = ctx.instructions_remaining();
+    let main = module
+        .get_value(js_string!("main"), &mut ctx)
+        .unwrap()
+        .as_callable()
+        .unwrap();
+    assert_eq!(
+        main.call(&JsValue::undefined(), &[], &mut ctx)
+            .unwrap()
+            .as_number(),
+        Some(42.0)
+    );
+    assert!(ctx.instructions_remaining() < after_init);
+    assert!(ctx.instructions_remaining() > 0);
+    exhausted(ctx.run_jobs().unwrap_err());
+    assert_eq!(ctx.instructions_remaining(), 0);
+    assert_eq!(global_number(&mut ctx, "called"), Some(1.0));
+    assert_eq!(global_number(&mut ctx, "jobStarted"), Some(1.0));
+    assert_eq!(global_number(&mut ctx, "jobCaught"), None);
+    assert_eq!(global_number(&mut ctx, "jobAfter"), None);
+}
