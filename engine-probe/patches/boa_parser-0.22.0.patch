+#[cfg(test)]
+mod source_retention_tests {
+    use super::Cursor;
+
+    #[test]
+    fn discard_preserves_utf16_positions_and_crlf() {
+        for input in [
+            "abc",
+            "aé😀z",
+            "a\r\nb\rc\nd\u{2028}e\u{2029}",
+            "/* 😀 */\r\nx",
+        ] {
+            let mut retained = Cursor::from(input.as_bytes());
+            let mut discarded = Cursor::from(input.as_bytes());
+            discarded.set_source_text_retention(false);
+            loop {
+                let a = retained.next_char().unwrap();
+                let b = discarded.next_char().unwrap();
+                assert_eq!(a, b);
+                assert_eq!(retained.pos_group(), discarded.pos_group());
+                if a.is_none() {
+                    break;
+                }
+            }
+            assert_eq!(discarded.linear_pos().pos(), input.encode_utf16().count());
+            assert!(discarded.source_collector.is_none());
+            assert_eq!(discarded.take_source().cur_linear_position().pos(), 0);
+            assert_eq!(
+                retained.take_source().cur_linear_position().pos(),
+                input.encode_utf16().count()
+            );
+        }
+    }
+
+    #[test]
+    fn discard_counts_lone_utf16_surrogate() {
+        let input = [0xD800_u16, 0x61, 0xD83D, 0xDE00, 0xDC00];
+        let source = crate::Source::from_utf16(&input);
+        let mut cursor = Cursor::new(source.reader);
+        cursor.set_source_text_retention(false);
+        while cursor.next_char().unwrap().is_some() {}
+        assert_eq!(cursor.linear_pos().pos(), input.len());
+        assert!(cursor.source_collector.is_none());
+    }
+}
